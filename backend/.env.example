# Copy to backend/.env and fill in what you need. Never commit backend/.env.

# ---- LLM provider -------------------------------------------------------
# auto (default): anthropic if ANTHROPIC_API_KEY is set, else openai_compat if
# AION_OPENAI_BASE_URL + AION_OPENAI_MODEL are set, else "none" (deterministic
# heuristic analyzer + revert patches, no LLM).
AION_LLM_PROVIDER=auto

# Option A - Claude (Anthropic API)
# ANTHROPIC_API_KEY=sk-ant-...
# AION_ANTHROPIC_MODEL=claude-opus-5-5
# AION_ANTHROPIC_EFFORT=high

# Option B - any OpenAI-compatible server
#   LM Studio (local):  AION_OPENAI_BASE_URL=http://localhost:1234/v1
#   Ollama (local):     AION_OPENAI_BASE_URL=http://localhost:11434/v1
#   Groq / OpenAI etc.: their base URL + AION_OPENAI_API_KEY
# AION_OPENAI_BASE_URL=http://localhost:1234/v1
# AION_OPENAI_MODEL=qwen2.5-coder-7b-instruct
# AION_OPENAI_API_KEY=

# ---- Incident detection --------------------------------------------------
# AION_DETECTION_WINDOW=60        # seconds
# AION_DETECTION_MIN_COUNT=5      # errors in window before an incident opens
# AION_DETECTION_BASELINE=1800    # seconds of history used as the baseline
# AION_DETECTION_SPIKE_RATIO=3.0  # current must be >= ratio x baseline average

# ---- Pipeline -------------------------------------------------------------
# AION_AUTO_PIPELINE=true         # investigate automatically when an incident opens
# AION_MAX_PATCH_ATTEMPTS=2       # generate-validate-repair attempts (LLM mode)
# AION_TEST_TIMEOUT=180

# ---- Security (Phase 3) -----------------------------------------------------
# Token for machine clients (log shippers, CI, the demo). Generate one with:
#   backend\.venv\Scripts\python -m aion.cli service-token --write
# AION_SERVICE_TOKEN=
# AION_SESSION_HOURS=12
# AION_REQUIRED_APPROVALS=1        # 2 = two-person rule (four-eyes principle)
# AION_REDACT_PROMPTS=true         # mask secrets/PII before anything reaches an LLM
# AION_SANDBOX=local               # "docker" runs AI-generated code in isolated containers
# AION_SANDBOX_IMAGE=aion-sandbox:py310   # build with scripts\build-sandbox.ps1

# ---- AI connectivity (Phase 4) ------------------------------------------------
# The AI provider can also be chosen in the dashboard (System -> AI provider); that choice
# overrides the LLM settings above. API keys entered there are encrypted with this key:
#   backend\.venv\Scripts\python -m aion.cli secret-key --write
# AION_SECRET_KEY=
# Token for AI apps connected through the MCP connector (python -m aion.mcp_server):
#   backend\.venv\Scripts\python -m aion.cli agent-token --write
# AION_AGENT_TOKEN=
# AION_MCP_TASK_TIMEOUT=900        # seconds the pipeline waits for the MCP agent per task
# AION_LLM_PROVIDER=mcp            # select the MCP connector from .env instead of the dashboard

# ---- GitHub (Phase 5) --------------------------------------------------------
# Fine-grained token for ONE repo: Contents, Pull requests, Workflows = read/write; Actions = read
# AION_GITHUB_TOKEN=github_pat_...
# AION_GITHUB_REPO=owner/repo           # linked to services registered without github_repo
# AION_REQUIRE_GITHUB_CI=true           # approval + deployment wait for GitHub Actions to pass
# AION_GITHUB_POLL=15                   # seconds between CI status refreshes
